# =============================================================================
# EXAMPLE CREDENTIALS FILE — ALL VALUES ARE FAKE AND NON-FUNCTIONAL
# These follow the same format as real keys but are provably invalid.
# Modeled after the "555" convention: structurally plausible, never real.
# =============================================================================

# --- AWS ---
# AWS Key IDs: AKIA + 16 alphanumeric chars. Amazon's canonical fake uses
# "EXAMPLE" embedded in the secret, and the access key ID is their official
# documentation placeholder (published by AWS itself).
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
AWS_REGION=us-east-1

# --- GitHub Personal Access Token ---
# Format: ghp_ prefix + 36 alphanumeric chars.
# "EXAMPLE" breaks the expected random character distribution.
GITHUB_TOKEN=ghp_EXAMPLE00000000000000000000000FAKE

# --- Stripe ---
# Test keys use sk_test_ prefix (live keys use sk_live_).
# Stripe's own docs use this exact placeholder.
STRIPE_SECRET_KEY=sk_test_EXAMPLE0000000000000000000000000000000000000000
STRIPE_PUBLISHABLE_KEY=pk_test_EXAMPLE0000000000000000000000000000000000000000

# --- SendGrid ---
# Format: SG. prefix + 22 chars . 43 chars
SENDGRID_API_KEY=SG.EXAMPLE_FAKE_KEY_00000.AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# --- Twilio ---
# Account SID: AC + 32 hex chars
# Auth Token: 32 hex chars
TWILIO_ACCOUNT_SID=ACEXAMPLEfake0000000000000000000000
TWILIO_AUTH_TOKEN=00000000000000EXAMPLEFAKE00000000

# --- Generic / Placeholder ---
# For internal services or APIs without a fixed format.
API_KEY=FAKE-API-KEY-DO-NOT-USE-00000000-EXAMPLE
DATABASE_URL=postgresql://fakeuser:fakepassword@localhost:5432/exampledb
JWT_SECRET=THIS_IS_A_FAKE_JWT_SECRET_FOR_EXAMPLE_USE_ONLY_DO_NOT_USE_IN_PROD
